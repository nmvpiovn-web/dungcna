{
  "name": "tienganh7-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "$lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/generate_build_meta.js && vite build",
    "preview": "wrangler pages dev build --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "gen": "wrangler types",
    "check": "npx --yes svelte-check --threshold error && wrangler types --check",
    "test": "node --test tests/*.test.js",
    "test:v5-gate": "node scripts/run_v5_module_gate.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "svelte": "^5.56.1",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299"
  }
}
